# Replace these placeholders before use; they deliberately cannot start a relay.
# The backend stores only SHA-256 of the high-entropy Worker bearer token.
EXIT_TOKEN_SHA256=REPLACE_WITH_64_HEX_CHARACTERS
# An IPv4 address actually assigned to this host (not a remote public/NAT IP).
EXIT_SOURCE_IPV4=192.0.2.10
# Include every public/NAT address of the relay and other forbidden destinations.
EXIT_BLOCKED_IPV4=192.0.2.10,198.51.100.10
